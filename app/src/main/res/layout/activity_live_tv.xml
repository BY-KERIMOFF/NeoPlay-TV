<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Panoramic Background -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/app_background"
        android:scaleType="centerCrop" />

    <!-- Dark Overlay for Readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Panel 1: Sidebar Categories -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.8"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@color/bg_sidebar">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MENU"
                android:textColor="@color/gold_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.2"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategories"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusable="true" />
        </LinearLayout>

        <!-- Panel 2: Channels -->
        <LinearLayout
            android:id="@+id/panelChannels"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2.8"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp"
                android:background="@drawable/glass_card_bg"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvPanelTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="KANALLAR"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp" />

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:hint="Axtar..."
                    android:textColorHint="#80FFFFFF"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:background="@android:color/transparent"
                    android:imeOptions="actionSearch"
                    android:inputType="text" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvChannels"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusable="true"
                android:clipToPadding="false"
                android:padding="8dp" />
        </LinearLayout>

        <!-- Panel 3: Mini Player & EPG -->
        <LinearLayout
            android:id="@+id/panelPlayer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3.4"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/bg_sidebar">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="260dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                android:backgroundTint="@color/black">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/miniPlayerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:use_controller="false" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp">

                <ImageView
                    android:id="@+id/ivCurrentChannelLogo"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:scaleType="fitCenter"
                    android:background="@drawable/glass_card_bg"
                    android:padding="4dp"
                    android:src="@drawable/default_logo" />

                <TextView
                    android:id="@+id/tvCurrentChannel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Seçin..."
                    android:textColor="@color/gold_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginStart="16dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEpgTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EPG Məlumatı yoxdur"
                android:textColor="@android:color/darker_gray"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />

            <ProgressBar
                android:id="@+id/epgProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:progress="0"
                android:progressTint="@android:color/holo_blue_light" />

        </LinearLayout>

    </LinearLayout>
</FrameLayout>
