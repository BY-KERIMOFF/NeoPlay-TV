<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/bg_main"
    android:padding="40dp">

    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@android:drawable/ic_lock_lock"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        app:tint="@color/gold_primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="TƏTBİQ KİLİDLİDİR"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Zəhmət olmasa 4 rəqəmli PİN kodu daxil edin"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/etLockPin"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:inputType="numberPassword"
        android:maxLength="4"
        android:gravity="center"
        android:textSize="32sp"
        android:textColor="@color/white"
        android:background="@drawable/glass_card_bg"
        android:padding="16dp"
        android:letterSpacing="1" />

    <Button
        android:id="@+id/btnUnlock"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="GİRİŞ"
        android:backgroundTint="@color/gold_primary"
        android:textColor="@color/black"
        android:textStyle="bold" />

</LinearLayout>
