<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Panoramic Background -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/app_background"
        android:scaleType="centerCrop" />

    <!-- Dark Overlay for Readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000" />

    <!-- Loading State -->
    <LinearLayout
        android:id="@+id/loadingLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/ivSplashLogo"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:src="@mipmap/ic_launcher"
            android:scaleType="fitCenter" />

        <ProgressBar
            android:id="@+id/splashProgress"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginTop="32dp"
            android:indeterminateTint="@color/gold_primary"
            style="@android:style/Widget.Material.ProgressBar.Small" />

        <TextView
            android:id="@+id/tvEnjoyWatching"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/enjoy_watching"
            android:textColor="@color/gold_primary"
            android:textSize="28sp"
            android:textStyle="italic|bold"
            android:visibility="invisible"
            android:fontFamily="serif" />
    </LinearLayout>

    <!-- Main Dashboard -->
    <LinearLayout
        android:id="@+id/dashboardLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingTop="15dp"
        android:paddingBottom="40dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:elevation="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_centerVertical="true">

                <androidx.cardview.widget.CardView
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    app:cardCornerRadius="55dp"
                    app:cardElevation="8dp"
                    android:layout_marginEnd="20dp"
                    app:cardBackgroundColor="#1AFFFFFF">

                    <ImageView
                        android:id="@+id/ivDashboardLogoSmall"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@mipmap/ic_launcher_round"
                        android:padding="12dp"
                        android:scaleType="fitCenter" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NEO PLAY"
                    android:textColor="@color/gold_primary"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="end"
                android:orientation="vertical">

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="HH:mm"
                    android:format24Hour="HH:mm"
                    android:textColor="@color/white"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cümə, 24 İyul"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp" />
            </LinearLayout>
        </RelativeLayout>

        <TextView
            android:id="@+id/tvExpiryInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/gold_dark"
            android:textSize="16sp"
            android:layout_marginBottom="24dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/cardsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="4">

            <!-- Live TV -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardLiveTv"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_weight="1"
                android:layout_margin="10dp"
                android:focusable="true"
                android:clickable="true"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp"
                android:backgroundTint="@color/bg_sidebar">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/glass_card_bg">
                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:src="@android:drawable/ic_menu_slideshow"
                        app:tint="@color/gold_primary" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CANLI TV"
                        android:textColor="@color/white"
                        android:layout_marginTop="12dp"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Movies -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardMovies"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_weight="1"
                android:layout_margin="10dp"
                android:focusable="true"
                android:clickable="true"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp"
                android:backgroundTint="@color/bg_sidebar">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/glass_card_bg">
                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:src="@android:drawable/ic_menu_gallery"
                        app:tint="@color/gold_primary" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FİLMLƏR"
                        android:textColor="@color/white"
                        android:layout_marginTop="12dp"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Series -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSeries"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_weight="1"
                android:layout_margin="10dp"
                android:focusable="true"
                android:clickable="true"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp"
                android:backgroundTint="@color/bg_sidebar">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/glass_card_bg">
                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:src="@android:drawable/ic_menu_sort_by_size"
                        app:tint="@color/gold_primary" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SERİALLAR"
                        android:textColor="@color/white"
                        android:layout_marginTop="12dp"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Favorites -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardFavorites"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_weight="1"
                android:layout_margin="10dp"
                android:focusable="true"
                android:clickable="true"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp"
                android:backgroundTint="@color/bg_sidebar">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/glass_card_bg">
                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:src="@android:drawable/btn_star_big_on"
                        app:tint="@color/gold_primary" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SEVİMLİLƏR"
                        android:textColor="@color/white"
                        android:layout_marginTop="12dp"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="32dp"
            android:gravity="end">

            <Button
                android:id="@+id/btnSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AYARLAR"
                android:backgroundTint="@color/glass_white_heavy"
                android:textColor="@color/white"
                android:layout_marginEnd="16dp" />

            <Button
                android:id="@+id/btnSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AXTARIŞ"
                android:backgroundTint="@color/gold_dark"
                android:textColor="@color/white" />
        </LinearLayout>

    </LinearLayout>

    <!-- Error/Expired Dialog Overlay -->
    <LinearLayout
        android:id="@+id/errorOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F20A0A0A"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="50dp">

        <TextView
            android:id="@+id/errorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Xəta"
            android:textColor="@android:color/holo_red_light"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/errorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Mesaj bura gələcək"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/macDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="MAC: 00:00:00:00:00"
            android:textColor="@color/gold_primary"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="Təkrar Yoxla"
            android:backgroundTint="@color/white"
            android:textColor="@color/black" />

    </LinearLayout>

</FrameLayout>
